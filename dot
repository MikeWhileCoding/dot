#!/usr/bin/env zsh
# dot — personal dotfiles CLI
set -euo pipefail

# ── Resolve repo root relative to this script ─────────────────────────
DOT_REPO="${0:A:h}"

# ── Load core library ─────────────────────────────────────────────────
source "${DOT_REPO}/lib/core.sh"
source "${DOT_REPO}/lib/project.sh"

# ── Module helpers ─────────────────────────────────────────────────────

_load_module() {
  local name="$1"
  local mod_file="${DOT_REPO}/modules/${name}.sh"
  if [[ ! -f "$mod_file" ]]; then
    error "Module not found: ${name}"
    return 1
  fi
  source "$mod_file"
}

_load_profile() {
  local name="$1"
  local prof_file="${DOT_REPO}/profiles/${name}.sh"
  if [[ ! -f "$prof_file" ]]; then
    error "Profile not found: ${name}"
    return 1
  fi
  source "$prof_file"
}

_list_modules() {
  for f in "${DOT_REPO}"/modules/*.sh(N); do
    local saved_name="" saved_desc=""
    (
      source "$f"
      printf "  %-14s %s\n" "$MODULE_NAME" "$MODULE_DESC"
    )
  done
}

_list_profiles() {
  for f in "${DOT_REPO}"/profiles/*.sh(N); do
    (
      source "${DOT_REPO}/lib/core.sh"
      source "$f"
      printf "  %-14s %s  [%s]\n" "$PROFILE_NAME" "$PROFILE_DESC" "${PROFILE_MODULES[*]}"
    )
  done
}

# ── Commands ───────────────────────────────────────────────────────────

cmd_install() {
  if [[ "${1:-}" == "--profile" ]]; then
    local profile_name="${2:?Usage: dot install --profile <name>}"
    _load_profile "$profile_name"
    header "Installing profile: ${PROFILE_NAME}"
    for mod in "${PROFILE_MODULES[@]}"; do
      _load_module "$mod"
      header "Installing module: ${mod}"
      module_install
    done
    if typeset -f profile_post_install > /dev/null; then
      profile_post_install
    fi
  else
    local mod_name="${1:?Usage: dot install <module>}"
    _load_module "$mod_name"
    header "Installing module: ${mod_name}"
    module_install
  fi
}

cmd_update() {
  local target="${1:-all}"

  if [[ "$target" == "all" ]]; then
    header "Updating all modules"
    for f in "${DOT_REPO}"/modules/*.sh(N); do
      source "$f"
      header "Updating: ${MODULE_NAME}"
      module_update
    done
  else
    _load_module "$target"
    header "Updating: ${target}"
    module_update
  fi
}

cmd_status() {
  local target="${1:-}"

  if [[ -n "$target" ]]; then
    _load_module "$target"
    module_status
  else
    header "Status — all modules"
    for f in "${DOT_REPO}"/modules/*.sh(N); do
      source "$f"
      module_status
      echo
    done
  fi
}

cmd_config() {
  local target="${1:-all}"

  if [[ "$target" == "all" ]]; then
    header "Applying configs — all modules"
    for f in "${DOT_REPO}"/modules/*.sh(N); do
      source "$f"
      if typeset -f module_config > /dev/null; then
        header "Config: ${MODULE_NAME}"
        module_config
      fi
    done
  else
    _load_module "$target"
    header "Config: ${target}"
    if typeset -f module_config > /dev/null; then
      module_config
    else
      warn "Module '${target}' has no config step"
    fi
  fi
}

cmd_init() {
  # Bootstrap / doctor: verify the environment dot needs, and offer to fix it.
  header "dot init — environment check"

  local issues=0

  # ── zsh ──────────────────────────────────────────────────────────────
  # If we got this far zsh exists (dot runs under it), but it may not be the
  # login shell — and ./bootstrap.sh is what handles a machine without zsh.
  local zsh_path="${commands[zsh]:-}"
  if [[ -n "$zsh_path" ]]; then
    success "zsh: $(zsh --version 2>/dev/null) (${zsh_path})"
    if [[ "${SHELL:t}" != "zsh" ]]; then
      warn "Login shell is ${SHELL:-unknown}, not zsh"
      if ! grep -qxF "$zsh_path" /etc/shells 2>/dev/null; then
        info "  Register it:  echo '${zsh_path}' | sudo tee -a /etc/shells"
      fi
      info "  Make default: chsh -s ${zsh_path}"
      issues=$(( issues + 1 ))
    fi
  else
    error "zsh is not installed — run ./bootstrap.sh to install it"
    issues=$(( issues + 1 ))
  fi

  # ── Required tools ───────────────────────────────────────────────────
  local tool missing=()
  for tool in curl tar git; do
    if command -v "$tool" &>/dev/null; then
      success "${tool}: $(command -v $tool)"
    else
      error "${tool}: missing"
      missing+=("$tool")
      issues=$(( issues + 1 ))
    fi
  done
  if (( ${#missing[@]} )); then
    local cmd
    if cmd="$(pkg_install_cmd ${missing[@]})"; then
      info "  Install with: ${cmd}"
      if confirm "Run this now?"; then
        eval "$cmd" && success "Installed: ${missing[*]}" || warn "Install failed"
      fi
    fi
  fi

  # ── Build toolchain (make + gcc) ─────────────────────────────────────
  # Needed by neovim (treesitter, fzf-native) and any source-built module.
  if have_build_tools; then
    success "build tools: make + $(command -v cc || command -v gcc || command -v clang)"
  else
    ensure_build_tools "Neovim treesitter parsers and source-built modules (tmux, zsh)" || issues=$(( issues + 1 ))
  fi

  # ── PATH ─────────────────────────────────────────────────────────────
  if [[ ":${PATH}:" == *":${DOT_BIN}:"* ]]; then
    success "PATH: ${DOT_BIN} is on your PATH"
  else
    warn "PATH: ${DOT_BIN} is not on your PATH — adding it to your shell rc"
    ensure_path_entry
    info "  Run: source ~/.zshrc"
    issues=$(( issues + 1 ))
  fi

  # ── dot on PATH ──────────────────────────────────────────────────────
  if [[ ! -e "${DOT_BIN}/dot" ]] && [[ "${commands[dot]:-}" != "${DOT_REPO}/dot" ]]; then
    if confirm "Link 'dot' into ${DOT_BIN}?"; then
      ln -sf "${DOT_REPO}/dot" "${DOT_BIN}/dot"
      success "Linked ${DOT_BIN}/dot → ${DOT_REPO}/dot"
    fi
  fi

  # ── Summary ──────────────────────────────────────────────────────────
  echo
  if (( issues == 0 )); then
    success "Environment looks good — try: dot install --profile desktop"
  else
    warn "${issues} item(s) need attention (see above), then re-run: dot init"
  fi
}

cmd_list() {
  header "Modules"
  _list_modules
  header "Profiles"
  _list_profiles
}

cmd_help() {
  cat <<'USAGE'
Usage: dot <command> [args]

Commands:
  init                          Check the environment (zsh, build tools, PATH)
  install <module>              Install a single module
  install --profile <name>      Install all modules in a profile
  update [<module>|all]         Update one module or everything
  config [<module>|all]         Re-apply config symlinks / settings
  status [<module>]             Show installed version / stamp
  list                          List all modules and profiles
  help                          Show this help message

Per-project (run inside a project):
  project show                  Show where this project's tools run
  project init [--local]        Detect containers and write .nvim-tools.json
  project check                 Verify php/pint/phpstan/biome are reachable
USAGE
}

# ── Dispatch ───────────────────────────────────────────────────────────
case "${1:-help}" in
  init)    shift; cmd_init    "$@" ;;
  install) shift; cmd_install "$@" ;;
  update)  shift; cmd_update  "$@" ;;
  config)  shift; cmd_config  "$@" ;;
  status)  shift; cmd_status  "$@" ;;
  project) shift; cmd_project "$@" ;;
  list)    cmd_list              ;;
  help|*)  cmd_help              ;;
esac
